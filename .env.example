# ==========================================
# OLIGOBOT V10 - Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# ==========================================
# Telegram Bot
# ==========================================
TELEGRAM_TOKEN=your_bot_token_here
ADMIN_ID=your_admin_user_id
ADMIN_SECRET=oligobot_admin_2026

# ==========================================
# AI Providers (at least one required)
# ==========================================
# Gemini (free tier - recommended for start)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (for vision and embeddings)
OPENAI_API_KEY=sk-your_openai_key_here

# DeepSeek (for text generation - cheap)
DEEPSEEK_API_KEY=your_deepseek_key_here

# ==========================================
# ArvanCloud (for embeddings - recommended)
# ==========================================
ARVAN_API_KEY=your_arvan_api_key_here
ARVAN_EMBEDDING_BASE_URL=https://ai-saas.arvancloud.ir/ai/v1
ARVAN_EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=32

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==========================================
# LLM Configuration
# ==========================================
# Router: which provider for each task
ROUTER_INTENT=gemini
ROUTER_KEYWORD=gemini
ROUTER_VISION=gemini
ROUTER_TEXT_GEN=deepseek

# LLM Profile: 1=Gemini Free, 2=ArvanCloud, 3=Gemma-4-31B
LLM_PROFILE=1

# Embedding provider: arvan/gemini/openai/local
EMBEDDING_PROVIDER=arvan

# ==========================================
# Optional: WARP Proxy
# ==========================================
# WARP_ENABLED=1
# WARP_PORT=40000

# ==========================================
# Optional: Admin Dashboard
# ==========================================
# ADMIN_HOST=0.0.0.0
# ADMIN_PORT=8080

# ==========================================
# Optional: Logging
# ==========================================
# LOG_LEVEL=INFO
# LOG_TO_FILE=true
